            </div>
	    <br>
            <div class="d-flex justify-content-between">
              <div class="value-text">Market Cap (USD)&nbsp;</div><div class="value-text text-end" hx-get="/rpc/market/cap_usd" hx-trigger="load, every 10s"></div>
