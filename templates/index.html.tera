            </div>
	    <br>
            <div class="d-flex justify-content-between">
	      <div class="value-text">iPollo G1
                <!-- Button trigger breakeven explanation modal -->
                <button type="button" class="btn-sm" data-bs-toggle="modal" data-bs-target="#breakeven_g1">
                  <i class="bi bi-question-circle"></i>
                </button>
              </div><div class="value-text text-end" hx-get="/rpc/mining/breakeven_g1" hx-trigger="load, every 10s"></div>
            </div>
	    <br>
            <div class="d-flex justify-content-between">
	      <div class="value-text">iPollo G1 mini
                <!-- Button trigger breakeven explanation modal -->
                <button type="button" class="btn-sm" data-bs-toggle="modal" data-bs-target="#breakeven_g1mini">
                  <i class="bi bi-question-circle"></i>
                </button>
              </div><div class="value-text text-end" hx-get="/rpc/mining/breakeven_g1mini" hx-trigger="load, every 10s"></div>
            </div>
          </div>
        </div>
        <div class="card border-bottom-0 border-start-0 border-end-0 rounded-0">
